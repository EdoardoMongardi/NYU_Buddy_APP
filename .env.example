# Firebase Configuration
# Get these values from Firebase Console > Project Settings > Your Apps > Web App
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# Admin emails (comma-separated list for admin page access)
# These users bypass @nyu.edu email restriction
NEXT_PUBLIC_ADMIN_EMAILS=admin@example.com

# ── Email Verification (OTP) ──
# Set these as Cloud Functions environment variables (firebase functions:config:set)
# or as runtime environment variables in the Firebase Console / .env file for functions.
#
# Example with Gmail:
#   EMAIL_SMTP_HOST=smtp.gmail.com
#   EMAIL_SMTP_PORT=587
#   EMAIL_SMTP_USER=your-app@gmail.com
#   EMAIL_SMTP_PASS=your-gmail-app-password   (generate at https://myaccount.google.com/apppasswords)
#   EMAIL_FROM_NAME=NYU Buddy
#
# These are set on the Cloud Functions side, NOT in the Next.js .env.local.
# Use: firebase functions:secrets:set EMAIL_SMTP_HOST  (etc.)