# ============================================================
# NYU Buddy — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.
# ============================================================

# ── Firebase Configuration ──────────────────────────────────
# Get these from Firebase Console > Project Settings > Your Apps > Web App
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
# VAPID key for Firebase Cloud Messaging push notifications
# Generate at Firebase Console > Project Settings > Cloud Messaging > Web Push certificates
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your-vapid-key

# ── Admin ───────────────────────────────────────────────────
# Comma-separated list of emails granted admin access.
# These users bypass the @nyu.edu email restriction.
NEXT_PUBLIC_ADMIN_EMAILS=admin@example.com

# ── Mapbox ──────────────────────────────────────────────────
# Public token for the map UI (client-side). Create at https://account.mapbox.com/
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your-mapbox-public-token

# Secret token for server-side tileset pipeline scripts (not exposed to the browser)
MAPBOX_ACCESS_TOKEN=sk.your-mapbox-secret-token
MAPBOX_USERNAME=your-mapbox-username

# ── Google ──────────────────────────────────────────────────
# Google Places API key for place search in the location decision flow.
# Enable the Places API in your Google Cloud Console.
GOOGLE_PLACES_API_KEY=your-google-places-api-key

# Path to Firebase Admin SDK service account JSON (for server-side operations).
# Download from Firebase Console > Project Settings > Service accounts > Generate new private key.
GOOGLE_APPLICATION_CREDENTIALS="./service-account.json"

# ── Development Toggles ────────────────────────────────────
# Set to "true" to connect to local Firebase emulators instead of production.
# Run `firebase emulators:start` in a separate terminal first.
NEXT_PUBLIC_USE_EMULATORS=false

# Set to "true" to expose the /design-playground route (UI component sandbox).
NEXT_PUBLIC_SHOW_DESIGN_PLAYGROUND=false

# ============================================================
# Cloud Functions — Email Verification (OTP)
# ============================================================
# These are NOT set in .env.local. They are configured as
# Firebase Functions secrets on the server side.
#
# Example with Gmail:
#   firebase functions:secrets:set EMAIL_SMTP_HOST   → smtp.gmail.com
#   firebase functions:secrets:set EMAIL_SMTP_PORT   → 587
#   firebase functions:secrets:set EMAIL_SMTP_USER   → your-app@gmail.com
#   firebase functions:secrets:set EMAIL_SMTP_PASS   → your-gmail-app-password
#                                                      (generate at https://myaccount.google.com/apppasswords)
#   firebase functions:secrets:set EMAIL_FROM_NAME   → NYU Buddy
